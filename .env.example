# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PakExcise.com

# Database (Neon PostgreSQL or local Docker)
# Local: copy .env.local from repo after `docker compose up -d`
# Production: pooled connection for DATABASE_URL, direct for DIRECT_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Better Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (Better Auth)
# Meta app needs "Facebook Login" use case and this redirect URI:
#   http://localhost:3000/api/auth/callback/facebook
# Production: https://your-domain.com/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Optional: Facebook Login for Business configuration ID
FACEBOOK_LOGIN_CONFIG_ID=

# Encryption (AES-256-GCM key, 32 bytes base64)
ENCRYPTION_KEY=

# Security peppers (random strings, never rotate without re-hashing stored values)
OTP_PEPPER=
IP_HASH_PEPPER=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pakexcise-files
R2_PUBLIC_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@pakexcise.com
# With onboarding@resend.dev, only this inbox receives mail until a domain is verified
RESEND_SANDBOX_OWNER_EMAIL=
NEXT_PUBLIC_RESEND_SANDBOX_OWNER_EMAIL=

# WhatsApp Cloud API (phone OTP + notifications) — separate Meta app from Facebook login
# From Meta: WhatsApp > API Setup (access token, phone number ID, WABA ID).
# Production: create Authentication template "pakexcise_otp" and set MODE=authentication.
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_OTP_TEMPLATE_NAME=pakexcise_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_MODE=authentication
WHATSAPP_OTP_TEMPLATE_PARAM_COUNT=1
# Dev only: log OTP to terminal when Meta API rejects (recipient not in test list, expired token, etc.)
WHATSAPP_DEV_FALLBACK_ON_ERROR=true

# Meta (Facebook login OAuth — can differ from WhatsApp app above)
META_APP_ID=
META_APP_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_ACCESS_TOKEN=

# Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=

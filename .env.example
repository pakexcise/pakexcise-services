# Realtime (SSE) — memory driver for single PM2 instance; valkey for multi-instance later
REALTIME_DRIVER=memory

# App
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PakExcise.com

# Database (Neon PostgreSQL or local Docker)
# Local: copy .env.local from repo after `docker compose up -d`
# Production: pooled connection for DATABASE_URL, direct for DIRECT_URL
# Use the pooled host for DATABASE_URL and the direct host for DIRECT_URL (Neon dashboard).
# Keep `.env` in sync with `.env.local` — run `npm run env:sync` after editing `.env.local`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Better Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption (AES-256-GCM key, 32 bytes base64)
ENCRYPTION_KEY=

# Security peppers (random strings, never rotate without re-hashing stored values)
OTP_PEPPER=
IP_HASH_PEPPER=
NOTIFICATION_RECIPIENT_PEPPER=

# Notification worker (QStash/cron POST /api/notifications/process)
NOTIFICATION_DISPATCH_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pakexcise-files
R2_PUBLIC_URL=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AWS SES (transactional email)
# Domain pakexcise.com must be verified in SES (us-east-1).
# IAM user needs ses:SendEmail on the verified identity.
# Optional dedicated SES keys (recommended if R2 uses different IAM credentials):
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=noreply@pakexcise.com
SES_REPLY_TO_EMAIL=info@pakexcise.com
# Remove any legacy Resend variables from .env / .env.production on the server.

# WhatsApp Cloud API (phone OTP + notifications) — separate Meta app from Facebook login
# From Meta: WhatsApp > API Setup (access token, phone number ID, WABA ID).
# Production: create Authentication template "pakexcise_otp" and set MODE=authentication.
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_OTP_TEMPLATE_NAME=pakexcise_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_MODE=authentication
WHATSAPP_OTP_TEMPLATE_PARAM_COUNT=1
# Dev only: log OTP to terminal when Meta API rejects (recipient not in test list, expired token, etc.)
WHATSAPP_DEV_FALLBACK_ON_ERROR=true

# Twilio SMS fallback (placeholder until credentials are configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta (Facebook login OAuth — can differ from WhatsApp app above)
META_APP_ID=
META_APP_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_ACCESS_TOKEN=

# Sentry (optional — init only when NEXT_PUBLIC_SENTRY_DSN is set)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=

# Bundle analyzer (dev only: ANALYZE=true pnpm build)
# ANALYZE=true

# Environment profiles
# Development (local):
# APP_ENV=development
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# BETTER_AUTH_URL=http://localhost:3000
#
# Staging (staging.pakexcise.com):
# APP_ENV=staging
# NEXT_PUBLIC_APP_URL=https://staging.pakexcise.com
# BETTER_AUTH_URL=https://staging.pakexcise.com
#
# Production (pakexcise.com):
# APP_ENV=production
# NEXT_PUBLIC_APP_URL=https://pakexcise.com
# BETTER_AUTH_URL=https://pakexcise.com

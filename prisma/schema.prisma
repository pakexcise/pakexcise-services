generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  AGENT
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
  SUSPENDED
}

enum AgentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  REVIEW
  DOCS_REQUIRED
  INVOICE_SENT
  PAYMENT_UPLOADED
  PAYMENT_VERIFIED
  IN_PROGRESS
  AT_OFFICE
  COMPLETED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  MISSING
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  FILE
  EMAIL
  PHONE
  CNIC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  EXPORT
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  phone               String?
  phoneNumber         String?    @unique
  phoneNumberVerified Boolean    @default(false)
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  twoFactorEnabled  Boolean    @default(false)
  twoFactorSecret   String?
  createdAt         DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  accounts             Account[]
  sessions             Session[]
  agentProfile         AgentProfile?
  customerApplications Application[]     @relation("CustomerApplications")
  agentApplications    Application[]     @relation("AgentApplications")
  uploadedDocuments    Document[]        @relation("DocumentUploader")
  verifiedDocuments    Document[]        @relation("DocumentVerifier")
  verifiedPayments     Payment[]         @relation("PaymentVerifier")
  auditLogs            AuditLog[]
  notifications        Notification[]
  statusChanges        StatusHistory[]

  @@index([role, status])
  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress           String?
  userAgent           String?
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model AgentProfile {
  id              String              @id @default(cuid())
  userId          String              @unique
  approvalStatus  AgentApprovalStatus @default(PENDING)
  commissionRate  Decimal             @default(0) @db.Decimal(5, 2)
  notes           String?             @db.Text
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approvalStatus, isActive])
  @@map("agent_profiles")
}

model Region {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameEn        String
  nameUr        String
  descriptionEn String?   @db.Text
  descriptionUr String?   @db.Text
  isActive      Boolean   @default(true)
  displayOrder  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  services Service[]
  seoMeta  SeoMeta?

  @@index([isActive, displayOrder])
  @@map("regions")
}

model Service {
  id                  String    @id @default(cuid())
  slug                String    @unique
  regionId            String
  nameEn              String
  nameUr              String
  shortDescriptionEn  String?   @db.Text
  shortDescriptionUr  String?   @db.Text
  contentEn           String?   @db.Text
  contentUr           String?   @db.Text
  ctaTextEn           String?
  ctaTextUr           String?
  processingNotesEn   String?   @db.Text
  processingNotesUr   String?   @db.Text
  requiresProof       Boolean   @default(true)
  isActive            Boolean   @default(true)
  displayOrder        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  region          Region                @relation(fields: [regionId], references: [id])
  formFields      ServiceFormField[]
  documentReqs    DocumentRequirement[]
  faqs            FAQ[]
  applications    Application[]
  seoMeta         SeoMeta?
  feeConfig       ServiceFeeConfig?

  @@index([slug])
  @@index([isActive, displayOrder])
  @@index([regionId, isActive])
  @@map("services")
}

/// Admin-only fee configuration. Never select in public repository queries.
model ServiceFeeConfig {
  id                     String   @id @default(cuid())
  serviceId              String   @unique
  defaultFacilitationFee Decimal? @db.Decimal(12, 2)
  internalNotes          String?  @db.Text
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_fee_configs")
}

model ServiceFormField {
  id               String    @id @default(cuid())
  serviceId        String
  fieldKey         String
  labelEn          String
  labelUr          String
  placeholderEn    String?
  placeholderUr    String?
  helpTextEn       String?   @db.Text
  helpTextUr       String?   @db.Text
  fieldType        FieldType
  isRequired       Boolean   @default(false)
  isEncrypted      Boolean   @default(false)
  optionsJson      Json?
  validationJson   Json?
  conditionalJson  Json?
  displayOrder     Int       @default(0)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  service     Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  fieldValues ApplicationFieldValue[]

  @@unique([serviceId, fieldKey])
  @@index([serviceId, isActive, displayOrder])
  @@map("service_form_fields")
}

model DocumentRequirement {
  id                String   @id @default(cuid())
  serviceId         String
  docType           String
  labelEn           String
  labelUr           String
  instructionsEn    String?  @db.Text
  instructionsUr    String?  @db.Text
  isRequired        Boolean  @default(true)
  maxSizeBytes      Int      @default(5242880)
  acceptedMimeTypes Json
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([serviceId, docType])
  @@index([serviceId, isActive, displayOrder])
  @@map("document_requirements")
}

model Application {
  id                 String            @id @default(cuid())
  trackingId         String            @unique
  userId             String
  agentId            String?
  serviceId          String
  status             ApplicationStatus @default(DRAFT)
  currentStep        Int               @default(1)
  draftJson          Json?
  locale             String            @default("en")
  firstTouchSource   String?
  firstTouchMedium   String?
  firstTouchCampaign String?
  lastTouchSource    String?
  lastTouchCampaign  String?
  gclid              String?
  fbclid             String?
  ttclid             String?
  landingPage        String?
  referrer           String?
  deviceType         String?
  adminNotes         String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user          User                    @relation("CustomerApplications", fields: [userId], references: [id])
  agent         User?                   @relation("AgentApplications", fields: [agentId], references: [id])
  service       Service                 @relation(fields: [serviceId], references: [id])
  fieldValues   ApplicationFieldValue[]
  documents     Document[]
  invoices      Invoice[]
  payments      Payment[]
  statusHistory StatusHistory[]
  notifications Notification[]
  attribution   AnalyticsAttribution?

  @@index([status, createdAt])
  @@index([trackingId])
  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@map("applications")
}

model ApplicationFieldValue {
  id              String   @id @default(cuid())
  applicationId   String
  fieldId         String
  valuePlain      String?  @db.Text
  valueEncrypted  String?  @db.Text
  valueJson       Json?
  isEncrypted     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field       ServiceFormField @relation(fields: [fieldId], references: [id])

  @@unique([applicationId, fieldId])
  @@map("application_field_values")
}

model Document {
  id              String         @id @default(cuid())
  applicationId   String
  requirementId   String?
  uploadedById    String?
  type            String
  r2Key           String
  fileName        String
  mimeType        String
  fileSize        Int
  checksum        String?
  status          DocumentStatus @default(PENDING)
  rejectionReason String?        @db.Text
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement DocumentRequirement? @relation(fields: [requirementId], references: [id])
  uploadedBy  User?                @relation("DocumentUploader", fields: [uploadedById], references: [id])
  verifiedBy  User?                @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  @@index([applicationId, type])
  @@index([status, createdAt])
  @@map("documents")
}

model Invoice {
  id                  String        @id @default(cuid())
  applicationId       String
  invoiceNumber       String        @unique
  status              InvoiceStatus @default(DRAFT)
  subtotal            Decimal       @db.Decimal(12, 2)
  taxTotal            Decimal       @default(0) @db.Decimal(12, 2)
  total               Decimal       @db.Decimal(12, 2)
  currency            String        @default("PKR")
  notes               String?       @db.Text
  officialFeeNote     String?       @db.Text
  paymentMethod       String?
  paymentInstructions String?       @db.Text
  pdfR2Key            String?
  locale              String        @default("en")
  sentAt              DateTime?
  dueAt               DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  application Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  lineItems   InvoiceLineItem[]
  payments    Payment[]

  @@index([applicationId, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id            String   @id @default(cuid())
  invoiceId     String
  label         String
  description   String?
  amount        Decimal  @db.Decimal(12, 2)
  isOfficialFee Boolean  @default(false)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, displayOrder])
  @@map("invoice_line_items")
}

model Payment {
  id                 String        @id @default(cuid())
  applicationId      String
  invoiceId          String
  status             PaymentStatus @default(PENDING)
  amount             Decimal       @db.Decimal(12, 2)
  screenshotR2Key    String?
  screenshotFileName String?
  screenshotMimeType String?
  screenshotFileSize Int?
  rejectionReason    String?       @db.Text
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  invoice     Invoice     @relation(fields: [invoiceId], references: [id])
  verifiedBy  User?       @relation("PaymentVerifier", fields: [verifiedById], references: [id])

  @@index([applicationId, status])
  @@map("payments")
}

model StatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String             @db.Text
  actorId       String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id])

  @@index([applicationId, createdAt])
  @@map("status_history")
}

model Notification {
  id            String              @id @default(cuid())
  userId        String?
  applicationId String?
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  title         String
  body          String              @db.Text
  payloadJson   Json?
  isRead        Boolean             @default(false)
  sentAt        DateTime?
  failedAt      DateTime?
  retryCount    Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user        User?        @relation(fields: [userId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AnalyticsAttribution {
  id            String   @id @default(cuid())
  applicationId String   @unique
  source        String?
  medium        String?
  campaign      String?
  gclid         String?
  fbclid        String?
  ttclid        String?
  landingPage   String?
  referrer      String?
  deviceType    String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([source, campaign])
  @@map("analytics_attribution")
}

model FAQ {
  id           String   @id @default(cuid())
  serviceId    String?
  category     String   @default("general")
  questionEn   String
  questionUr   String
  answerEn     String   @db.Text
  answerUr     String   @db.Text
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([isActive, displayOrder])
  @@index([category, isActive, displayOrder])
  @@index([serviceId, isActive, displayOrder])
  @@map("faqs")
}

model SocialLink {
  id           String   @id @default(cuid())
  platform     String
  labelEn      String
  labelUr      String
  url          String
  iconName     String   @default("Link")
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("social_links")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SeoMeta {
  id                String   @id @default(cuid())
  pageKey           String   @unique
  serviceId         String?  @unique
  regionId          String?  @unique
  blogPostId        String?  @unique
  guideId           String?  @unique
  metaTitleEn       String?
  metaTitleUr       String?
  metaDescriptionEn String?  @db.Text
  metaDescriptionUr String?  @db.Text
  h1En              String?
  h1Ur              String?
  canonicalUrl      String?
  ogTitleEn         String?
  ogTitleUr         String?
  ogDescriptionEn   String?  @db.Text
  ogDescriptionUr   String?  @db.Text
  ogImage           String?
  twitterCard       String?  @default("summary_large_image")
  robotsIndex       Boolean  @default(true)
  robotsFollow      Boolean  @default(true)
  faqSchemaJson     Json?
  breadcrumbJson    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  service  Service?  @relation(fields: [serviceId], references: [id])
  region   Region?   @relation(fields: [regionId], references: [id])
  blogPost BlogPost? @relation(fields: [blogPostId], references: [id])
  guide    Guide?    @relation(fields: [guideId], references: [id])

  @@map("seo_meta")
}

model Redirect {
  id         String   @id @default(cuid())
  oldSlug    String   @unique
  newSlug    String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([newSlug])
  @@map("redirects")
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleEn     String
  titleUr     String
  excerptEn   String?   @db.Text
  excerptUr   String?   @db.Text
  contentEn   String    @db.Text
  contentUr   String    @db.Text
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seoMeta SeoMeta?

  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model Guide {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleEn     String
  titleUr     String
  excerptEn   String?   @db.Text
  excerptUr   String?   @db.Text
  contentEn   String    @db.Text
  contentUr   String    @db.Text
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seoMeta SeoMeta?

  @@index([isPublished, publishedAt])
  @@map("guides")
}

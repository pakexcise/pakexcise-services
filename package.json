{
  "name": "pakexcise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --input-type=module -e \"console.log('No automated tests configured yet. See DEPLOYMENT.md for manual QA checklist.')\"",
    "analyze": "ANALYZE=true pnpm build",
    "db:generate": "node scripts/sync-env.mjs && prisma generate",
    "db:push": "node scripts/sync-env.mjs && prisma db push",
    "db:migrate": "node scripts/sync-env.mjs && prisma migrate dev",
    "db:seed": "node scripts/sync-env.mjs && tsx prisma/seed.ts",
    "db:setup": "docker compose up -d && node scripts/sync-env.mjs && prisma db push && tsx prisma/seed.ts",
    "db:studio": "node scripts/sync-env.mjs && prisma studio",
    "env:sync": "node scripts/sync-env.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.787.0",
    "@aws-sdk/s3-request-presigner": "3.787.0",
    "@hookform/resolvers": "5.0.1",
    "@prisma/client": "6.6.0",
    "@radix-ui/react-dialog": "1.1.11",
    "@radix-ui/react-dropdown-menu": "2.1.12",
    "@radix-ui/react-label": "2.1.4",
    "@radix-ui/react-navigation-menu": "1.2.10",
    "@radix-ui/react-separator": "1.1.4",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-switch": "1.2.2",
    "@react-email/components": "0.0.36",
    "@react-email/render": "1.0.6",
    "@react-pdf/renderer": "4.3.0",
    "@sentry/nextjs": "9.12.0",
    "@upstash/ratelimit": "2.0.5",
    "@upstash/redis": "1.34.8",
    "bcryptjs": "3.0.2",
    "better-auth": "1.2.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.503.0",
    "next": "16.2.7",
    "next-intl": "4.1.0",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.56.1",
    "resend": "4.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.2.8",
    "zod": "3.24.3",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.7",
    "@tailwindcss/postcss": "4.1.4",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "9.25.1",
    "eslint-config-next": "16.2.7",
    "prisma": "6.6.0",
    "tailwindcss": "4.1.4",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
